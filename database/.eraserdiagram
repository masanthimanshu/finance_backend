entity-relationship-diagram

user [icon: user, color: teal] {
    id string pk
    name string
    code string
    phone number
    isActive boolean
    isVerified boolean
}

profile [icon: data, color: purple] {
    id string pk
    user string
    income number
    balance number
    investment array
}

investment [icon: money, color: purple] {
    id string pk
    type string
    amount number
}

otp [icon: code, color: green] {
    id string pk
    user string
    value int
}

transaction [icon: ticket, color: navy] {
    id string pk
    input string
    user string
    amount number
    category string
    subCategory string
    time timestamp
}

user.id <> otp.user
user.id <> transaction.user

profile.user <> user.id
profile.investment <> investment
