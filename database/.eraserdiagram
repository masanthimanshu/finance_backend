entity-relationship-diagram

user [icon: user, color: teal] {
    id string pk
    code string
    phone number
    isActive boolean
    isVerified boolean
}

otp [icon: code, color: green] {
    id string pk
    user string
    value int
}

transaction [icon: ticket, color: navy] {
    id string pk
    input string
    user string
    amount number
    category string
    subCategory string
    time timestamp
}

user.id <> otp.user
user.id <> transaction.user
